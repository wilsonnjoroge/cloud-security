data "aws_ami" "al2023" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-*-x86_64"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

# ---------------------------------------------------------------------------
# SSH key pair, generated by Terraform. Only the web tier is reachable by
# SSH directly (per the SG rules); app/db are intended to be managed via
# SSM Session Manager instead, but all three get the same key pair for
# consistency / in case direct SSH is ever needed from a bastion.
# ---------------------------------------------------------------------------
resource "tls_private_key" "this" {
  algorithm = "RSA"
  rsa_bits  = 2048
}

resource "aws_key_pair" "this" {
  key_name   = "${var.project_name}-key"
  public_key = tls_private_key.this.public_key_openssh
}

resource "local_sensitive_file" "pem" {
  content         = tls_private_key.this.private_key_pem
  filename        = "${path.module}/${var.project_name}-key.pem"
  file_permission = "0400"
}

# ---------------------------------------------------------------------------
# Web tier -- public subnet, public IP, HTTP server on port 80
# ---------------------------------------------------------------------------
resource "aws_instance" "web" {
  ami                         = data.aws_ami.al2023.id
  instance_type               = var.instance_type
  subnet_id                   = aws_subnet.public.id
  vpc_security_group_ids      = [aws_security_group.web.id]
  key_name                    = aws_key_pair.this.key_name
  iam_instance_profile        = aws_iam_instance_profile.web_server.name
  associate_public_ip_address = true
  disable_api_termination     = false

  metadata_options {
  http_endpoint = "enabled"
  http_tokens   = "required"
  }

  root_block_device {
  encrypted   = true
  volume_type = "gp3"
  }

  user_data = <<-EOF
    #!/bin/bash
    echo "lab2-Application Web Tier 1 is Running and reachable" > index.html
    python3 -m http.server 80 &
  EOF

  tags = {
    Name = "${var.project_name}-Web-Server1"
  }
}

# ---------------------------------------------------------------------------
# App tier -- private subnet, no public IP, custom app server on port 5050
# ---------------------------------------------------------------------------
resource "aws_instance" "app" {
  ami                         = data.aws_ami.al2023.id
  instance_type               = var.instance_type
  subnet_id                   = aws_subnet.private.id
  vpc_security_group_ids      = [aws_security_group.app.id]
  key_name                    = aws_key_pair.this.key_name
  iam_instance_profile        = aws_iam_instance_profile.app_server.name
  associate_public_ip_address = false
  disable_api_termination     = false

  metadata_options {
  http_endpoint = "enabled"
  http_tokens   = "required"
  }

  root_block_device {
  encrypted   = true
  volume_type = "gp3"
  }

  user_data = <<-EOF
    #!/bin/bash
    echo "lab2-Application App tier 1 is Running and reachable" > index.html
    python3 -m http.server 5050 &
  EOF

  tags = {
    Name = "${var.project_name}-App-Server1"
  }
}

# ---------------------------------------------------------------------------
# DB tier -- private subnet, no public IP, simulated MySQL on port 3306
# ---------------------------------------------------------------------------
resource "aws_instance" "db" {
  ami                         = data.aws_ami.al2023.id
  instance_type               = var.instance_type
  subnet_id                   = aws_subnet.private.id
  vpc_security_group_ids      = [aws_security_group.db.id]
  key_name                    = aws_key_pair.this.key_name
  iam_instance_profile        = aws_iam_instance_profile.db_server.name
  associate_public_ip_address = false
  disable_api_termination     = false

  metadata_options {
  http_endpoint = "enabled"
  http_tokens   = "required"
  }

  root_block_device {
  encrypted   = true
  volume_type = "gp3"
  }


  user_data = <<-EOF
    #!/bin/bash
    echo "lab2-Application Db tier 1 is Running and reachable" > index.html
    python3 -m http.server 3306 &
  EOF

  tags = {
    Name = "${var.project_name}-Db-Server1"
  }
}
